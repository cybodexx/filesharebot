# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development.
# NEVER commit your real .env — it is listed in .gitignore.
# On Render (or any host) set these as environment variables in the dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org
API_ID=
API_HASH=

# Bot token from @BotFather
BOT_TOKEN=

# Channel ID where the bot stores files (must start with -100)
BIN_CHANNEL=

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (Transaction pooler)
# Format: postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
# Add  https://xxxx.supabase.co/auth/v1/callback  as an Authorised redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Session security ──────────────────────────────────────────────────────────
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ── App settings ──────────────────────────────────────────────────────────────
APP_NAME=vidshare.in

# Your public domain WITHOUT https:// (set after you know your Render URL)
# e.g.  FQDN=thunder-file-share.onrender.com
FQDN=

HAS_SSL=True
MAX_FILE_SIZE_MB=2000
LINK_EXPIRY_DAYS=10
DELETE_AFTER_DOWNLOAD=False
PORT=5000
BIND_ADDRESS=0.0.0.0
